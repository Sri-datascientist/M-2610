# ==============================================================================
# Meyveda Platform Backend Configuration Template
# Copy this file to .env and configure environment-specific credentials.
# NEVER commit .env with real production secrets to version control.
# ==============================================================================

PROJECT_NAME="MeyVeda Platform Backend"
API_V1_STR="/api/v1"

# Generate a strong 256-bit cryptographic key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Connection URL format:
# postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:your_password_here@localhost:5432/meyveda_db"

# Allowed CORS Origins (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ==============================================================================
# OTP Email Delivery (Zoho CPaaS / ZeptoMail REST API - Recommended)
# ==============================================================================
# Endpoint defaults to https://cpaas.zoho.in/v1.1/email
ZOHO_CPAAS_URL="https://cpaas.zoho.in/v1.1/email"
# Your Zoho CPaaS / ZeptoMail Send Mail API key:
ZOHO_CPAAS_API_KEY="Zoho-enczapikey your_api_key_here"
# Verified Sender address in Zoho ZeptoMail (e.g. noreply@meyveda.com):
ZOHO_CPAAS_FROM_EMAIL="noreply@meyveda.com"
ZOHO_CPAAS_FROM_NAME="Meyveda"

# ==============================================================================
# Alternative: Standard SMTP Email Delivery
# ==============================================================================
# SMTP_HOST="smtp.zeptomail.in"
# SMTP_PORT=587
# SMTP_USER="emailapikey"
# SMTP_PASSWORD="your_smtp_password"
# SMTP_FROM_EMAIL="noreply@meyveda.com"

# ==============================================================================
# SMS OTP Delivery (MSG91 SendOTP API - Recommended for India & Global)
# ==============================================================================
# Auth Key from MSG91 Dashboard
MSG91_AUTH_KEY="your_msg91_authkey_here"
# DLT-approved OTP Template ID from MSG91 OTP section (with ##OTP## variable)
MSG91_OTP_TEMPLATE_ID="your_msg91_otp_template_id_here"
# Optional API endpoint override (default: https://control.msg91.com/api/v5/otp)
# MSG91_OTP_URL="https://control.msg91.com/api/v5/otp"

# ==============================================================================
# Alternative: Twilio SMS Delivery
# ==============================================================================
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_FROM_NUMBER="+1XXXXXXXXXX"


